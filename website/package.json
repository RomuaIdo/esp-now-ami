{
  "name": "esp-now-waveform-display",
  "version": "1.0.0",
  "description": "Real-time AMI waveform display for ESP-NOW network",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:acm": "SERIAL_PORT=/dev/ttyACM0 node server.js",
    "start:usb": "SERIAL_PORT=/dev/ttyUSB0 node server.js"
  },
  "dependencies": {
    "@serialport/parser-readline": "^12.0.0",
    "chart.js": "^4.4.0",
    "express": "^4.18.0",
    "serialport": "^12.0.0",
    "socket.io": "^4.7.0"
  }
}
